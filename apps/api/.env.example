PORT=4000
# Local Docker Postgres, or a Neon/Supabase connection string
DATABASE_URL=postgres://chess:chess@localhost:5440/kingdom_chess
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Frontend origin allowed by CORS (cookies are sent cross-origin with credentials)
WEB_ORIGIN=http://localhost:3000
# Set to true behind HTTPS
COOKIE_SECURE=false
